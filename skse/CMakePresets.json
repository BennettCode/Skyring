{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "SkyrimXER (MSVC, Ninja, RelWithDebInfo)",
      "description": "Run from the VS Developer Shell (Launch-VsDevShell.ps1 -Arch amd64) so MSVC and the VS-bundled vcpkg (VCPKG_ROOT) are found.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/skse",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" }
  ]
}
